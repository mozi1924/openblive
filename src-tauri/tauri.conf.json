{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenBlive Studio",
  "version": "0.1.9",
  "identifier": "com.openblive.studio",
  "build": {
    "beforeDevCommand": "pnpm ensure:overlay && node scripts/tauri-dev-server.mjs",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build:desktop",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "OpenBlive Studio",
        "width": 1050,
        "height": 720,
        "resizable": true,
        "backgroundColor": "#07090e",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: http: https: asset:; connect-src 'self' http: https: ws: wss: ipc: tauri:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "resources": [
      "../dist/overlay"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEUyN0QyNDU2RTlBNUEyNjIKUldSaW9xWHBWaVI5NHRmZXlQWXhsYzBWbmhjd1hKZ05XR0E2TVlJUXBwUk15V1IvbnVwcTJNOEIK",
      "endpoints": [
        "https://github.com/mozi1924/openblive/releases/latest/download/latest.json"
      ]
    }
  }
}